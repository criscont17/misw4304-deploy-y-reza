{
  "family": "task-blacklist-api",
  "executionRoleArn": "arn:aws:iam::635858937828:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "3072",
  "containerDefinitions": [
    {
      "name": "blacklist-api",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql://postgres:postgres123@blacklist-db.cmhg4k0c0go1.us-east-1.rds.amazonaws.com:5432/blacklist_db"
        },
        {
          "name": "NEW_RELIC_LICENSE_KEY",
          "value": "FD034501DDD660060F5118F5E1AA270047CA0EFE16585A90DCDD68F5D1D56244"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/task-blacklist-api",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}